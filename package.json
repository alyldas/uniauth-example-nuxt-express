{
  "name": "@alyldas/uniauth-example-nuxt-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Strict-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alyldas/uniauth-example-nuxt-express.git"
  },
  "bugs": {
    "url": "https://github.com/alyldas/uniauth-example-nuxt-express/issues"
  },
  "homepage": "https://github.com/alyldas/uniauth-example-nuxt-express#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:core": "node scripts/prepare-core.js",
    "dev": "concurrently -k -n backend,nuxt -c cyan,green \"npm run dev:backend\" \"npm run dev:nuxt\"",
    "dev:backend": "NODE_OPTIONS=--preserve-symlinks tsx watch backend/index.ts",
    "dev:nuxt": "NODE_OPTIONS=--preserve-symlinks nuxt dev --host 127.0.0.1 --port 3000",
    "db:apply-schema": "NODE_OPTIONS=--preserve-symlinks tsx backend/drizzle/apply-schema.ts",
    "smoke:auth": "tsx scripts/smoke-auth-flow.ts",
    "check": "npm run typecheck && npm run build",
    "check:live": "npm run check && npm run smoke:auth",
    "build": "NODE_OPTIONS=--preserve-symlinks nuxt build && tsc -p tsconfig.backend.json",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.backend.json"
  },
  "dependencies": {
    "@alyldas/uniauth-core": "file:../uniauth-core",
    "@alyldas/uniauth-drizzle": "file:../uniauth-drizzle",
    "@alyldas/uniauth-express": "file:../uniauth-express",
    "@alyldas/uniauth-nuxt": "file:../uniauth-nuxt",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "nuxt": "^4.2.2",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.0"
  }
}
